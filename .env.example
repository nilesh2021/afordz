# Razorpay. Use rzp_test_ keys while testing. Use rzp_live_ keys only on the live site.
# Copy this file to .env.local and paste values from the Razorpay dashboard API keys page.
#
# Key id: full value from the dashboard (rzp_test_ or rzp_live_ plus the id segment).
# Key secret: separate field from the dashboard — it does NOT start with rzp_test_ or rzp_live_.
RAZORPAY_KEY_ID=rzp_test_replace_with_dashboard_key_id
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Order storage (see DEPLOYMENT.md)
# Local / VPS: optional path to SQLite file (default: ./data/orders.sqlite)
# AFORDZ_DB_PATH=/var/lib/afordz/orders.sqlite
# Vercel production: Turso Cloud (required — local SQLite does not work on Vercel)
# Use a full-access database token, not a read-only token.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=
